# Allowlist: ignore everything in this subproject by default...
*

# ...but keep descending into directories, so the rules below can reach inside
# them. Without this, git never looks inside src/ and the !/src/** below can
# never match.
!*/

# ...and un-ignore only what defines the project.
!/.gitignore
!/LICENSE
!/CMakeLists.txt
!/Makefile
!/src/**
!/include/**
!/cmake/**
!/python/**
!/tests/**
!/examples/**
!/.github/**
!/pyproject.toml
!/README.md
!/CHANGELOG.md
!/RELEASING.md
!/docs/**
!/site/**
!/tools/**
!/bench/**

# Build trees: re-ignored as whole directories so git doesn't walk them at all.
/build/
/cmake-build-*/
/dist/
/wheelhouse/
/.idea/
__pycache__/
*.egg-info/

# Benchmark inputs and images that run_all.sh regenerates.
/bench/data/
/bench/results/**/*.npz
